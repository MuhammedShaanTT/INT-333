<!doctype html>
<html>
  <head><title>{{ site_title }}</title></head>
  <body>
    <h1>{{ site_title }}</h1>
    <p>Host: <b>{{ inventory_hostname }}</b> ({{ ansible_facts['default_ipv4']['address'] | default('n/a') }})</p>
    <p>OS: {{ ansible_facts['distribution'] }} {{ ansible_facts['distribution_version'] }}</p>
    <h3>Installed packages managed by Ansible</h3>
    <ul>
    {% for pkg in packages %}
      <li>{{ pkg }}</li>
    {% endfor %}
    </ul>
  </body>
</html>
